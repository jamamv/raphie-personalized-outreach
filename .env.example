# Copy to .env and fill in. Never commit .env.
OPENAI_API_KEY=
# Optional overrides
OPENAI_MODEL=gpt-5.5
MAX_REPAIRS=2
HELPER_BUDGET_MS=20000
# Where each run is logged as one JSON line ("off" to disable)
RUN_LOG=runs.jsonl
PORT=3000

FEEDBACK_LOG=feedback.jsonl
# Optional: require this code on the web API (recommended for a public deploy)
ACCESS_CODE=
